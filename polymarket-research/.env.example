# Copy to .env and adjust. Env vars override runtime/connection settings in config.yaml.

# --- Database -------------------------------------------------------------
# Default is a local SQLite file (zero-config). For production use PostgreSQL:
#   POLYTRADER_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/polytrader
POLYTRADER_DATABASE_URL=sqlite:///data/polytrader.db

# --- Runtime --------------------------------------------------------------
# synthetic = run fully offline on generated data; live = pull from Polymarket APIs
POLYTRADER_DATA_SOURCE=synthetic
POLYTRADER_SEED=42

# Path to the analytical config (weights, thresholds)
POLYTRADER_CONFIG=config.yaml

# --- Live collection (only used when DATA_SOURCE=live) --------------------
# Optional API key for higher CLOB rate limits (public endpoints need none).
POLYTRADER_CLOB_API_KEY=
